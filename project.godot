[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="props"
3d_physics/layer_5="climbable"
3d_physics/layer_6="interactable"
3d_physics/layer_7="glass"
3d_physics/layer_8="doors"

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
common/physics_interpolation=true

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
anti_aliasing/quality/use_taa=true

[shader_globals]

wind_strength={
"type": "float",
"value": 0.2
}
wind_direction={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
